<Project>

  <!--
    Icon projects to build. Any icons.ini in the project tree is picked up by default; other files are
    added with <IconProject Include="assets\tray.ini" />. The glob lives here rather than in the .props
    file so that the SDK's default excludes (bin, obj) are already defined.
  -->
  <ItemGroup Condition="'$(EnableDefaultIconProjects)' == 'true'">
    <IconProject Include="**\icons.ini" Exclude="$(DefaultItemExcludes);$(DefaultExcludesInProjectFolder)" />
  </ItemGroup>

  <PropertyGroup>
    <IconPackagerToolPath Condition="'$(IconPackagerToolPath)' == ''">$(MSBuildThisFileDirectory)..\tools\net10.0\IconPackager.dll</IconPackagerToolPath>
    <!--
      Where the icons are written: under obj by default, so that they stay out of source control and go
      with Clean. Defined here, after the common targets, because IntermediateOutputPath is not known
      before them; a project can read it in a Directory.Build.targets or inside a target, not in its body.
    -->
    <IconPackagerOutputDir Condition="'$(IconPackagerOutputDir)' == ''">$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'icons'))</IconPackagerOutputDir>
    <!-- A montage of every frame, name.montage.png, is written next to each icon. Set false to skip it. -->
    <IconPackagerMontage Condition="'$(IconPackagerMontage)' == ''">true</IconPackagerMontage>
    <!-- Names the icon in the output folder to embed as the application icon, since the project body cannot spell that path itself. -->
    <ApplicationIcon Condition="'$(IconPackagerApplicationIcon)' != ''">$(IconPackagerOutputDir)$(IconPackagerApplicationIcon)</ApplicationIcon>
  </PropertyGroup>

  <!--
    Builds the icons before the compiler runs, so that an ApplicationIcon written here is ready to be
    embedded. Design-time builds in the IDE skip it. The tool reports problems in MSBuild's error format
    with the icons.ini line they concern, so they appear in the error list and fail the build.
  -->
  <Target Name="IconPackagerBuildIcons"
          BeforeTargets="CoreCompile"
          Condition="'@(IconProject)' != '' and '$(DesignTimeBuild)' != 'true'">

    <Error Code="IP0001"
           Condition="!$([MSBuild]::IsOSPlatform('Windows'))"
           Text="IconPackager renders with System.Drawing and builds icons only on Windows. Condition the IconProject items or EnableDefaultIconProjects on $([MSBuild]::IsOSPlatform('Windows')) to skip it elsewhere." />

    <PropertyGroup>
      <_IconPackagerHost>$(DOTNET_HOST_PATH)</_IconPackagerHost>
      <_IconPackagerHost Condition="'$(_IconPackagerHost)' == ''">dotnet</_IconPackagerHost>
      <!-- Without the trailing separator, which would escape the closing quote on the command line. -->
      <_IconPackagerSwitches>--out &quot;$(IconPackagerOutputDir.TrimEnd('\'))&quot;</_IconPackagerSwitches>
      <_IconPackagerSwitches Condition="'$(IconPackagerMontage)' == 'true'">$(_IconPackagerSwitches) --montage</_IconPackagerSwitches>
    </PropertyGroup>

    <Message Importance="high" Text="Building icons from @(IconProject, ', ') into $(IconPackagerOutputDir)" />
    <Exec Command="&quot;$(_IconPackagerHost)&quot; &quot;$(IconPackagerToolPath)&quot; $(_IconPackagerSwitches) @(IconProject->'&quot;%(FullPath)&quot;', ' ')"
          IgnoreExitCode="true">
      <Output TaskParameter="ExitCode" PropertyName="_IconPackagerExitCode" />
    </Exec>
    <Error Code="IP0002"
           Condition="'$(_IconPackagerExitCode)' != '0'"
           Text="IconPackager exited with code $(_IconPackagerExitCode); the errors it reported above say why." />

    <!-- Everything in the folder is a build output, so that Clean removes it. -->
    <ItemGroup>
      <FileWrites Include="$(IconPackagerOutputDir)**" />
    </ItemGroup>

  </Target>

</Project>
