<Project>

  <!-- Shared package metadata. Each project adds its own Description and PackageTags. -->
  <PropertyGroup>
    <Version>0.1.0</Version>
    <Authors>Patrick Zahra</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/pzahra/IconPackager</PackageProjectUrl>
    <RepositoryUrl>https://github.com/pzahra/IconPackager</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
